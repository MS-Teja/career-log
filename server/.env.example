PORT=5050
NODE_ENV=development

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careerlog?retryWrites=true&w=majority

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Only emails ending in this domain can register (comma-separate several). Leave empty to allow any.
ALLOWED_EMAIL_DOMAIN=college.edu

# Email (OTP codes and notifications). Leave all empty in development: emails print to this terminal.
# Option A, Brevo (needed on Render's free tier, which blocks SMTP): API key + a sender you verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=
# Option B, Gmail SMTP: your address + an App Password (Google Account → Security → App passwords).
SMTP_USER=
SMTP_PASS=

CLIENT_URL=http://localhost:5173

# Used by `npm run seed` to create the admin account
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@12345
